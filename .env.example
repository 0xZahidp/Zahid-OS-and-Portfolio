# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Configuration (Supabase Auth User UUID)
ADMIN_USER_ID=your-admin-user-uuid-here

# GitHub Personal Access Token (PAT)
# You can store this in your local .env.local OR in a Supabase table (`app_settings` / `secrets`).
# Used to fetch private contributions and higher API rate limits.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Site Metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
