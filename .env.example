# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Publishable key alias
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin Authorization (Supabase Auth User UUID)
ADMIN_USER_ID=your-admin-user-uuid-here

# Optional: Secret test token for automated testing
ADMIN_TEST_TOKEN=

# GitHub Personal Access Token (PAT)
# Used to fetch private contributions and higher API rate limits.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Resend Email Integration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
RESEND_DEFAULT_SENDER="Md Zahid Hasan <hello@zahidp.com>"

# Contact Form & Notifications
CONTACT_FROM_EMAIL=hello@zahidp.com
CONTACT_TO_EMAIL=hello@zahidp.com
CONTACT_RATE_LIMIT_SECRET=your-random-hmac-secret-for-rate-limiting

# Site Metadata & SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NOINDEX=false

# Zahid OS Temp Mail Domain
TEMP_MAIL_DOMAIN=tmp.zahidp.com

# Encrypted Environment Vault (Optional AES-256 keys)
VAULT_ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY_PREVIOUS=

# Automated Test Suite Configuration (Optional)
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
TEST_HOST=
TEST_PORT=
