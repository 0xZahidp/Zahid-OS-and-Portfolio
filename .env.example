# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Configuration (Supabase Auth User UUID)
ADMIN_USER_ID=your-admin-user-uuid-here

# GitHub Personal Access Token (PAT)
# Used to fetch private contributions and higher API rate limits.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Resend Email Integration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

# Contact Form Security
CONTACT_RATE_LIMIT_SECRET=your-random-hmac-secret-for-rate-limiting

# Site Metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
